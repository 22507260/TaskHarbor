{
  "name": "taskharbor",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm:api\" \"npm:worker\" \"npm:web\"",
    "api": "node --watch server/index.js",
    "worker": "node --watch server/worker.js",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
